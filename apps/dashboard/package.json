{
  "name": "@ap-sitecare/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "mcp": "node --import tsx mcp/server.ts",
    "backup-worker": "node --import tsx worker/backup-worker.ts",
    "backup-worker:continuous": "node --import tsx worker/backup-worker.ts --continuous",
    "automation-worker": "node --import tsx worker/automation-worker.ts",
    "automation-worker:continuous": "node --import tsx worker/automation-worker.ts --continuous",
    "bootstrap-admin": "node --import tsx scripts/bootstrap-admin.ts",
    "email-worker": "node --import tsx worker/email-worker.ts",
    "email-worker:continuous": "node --import tsx worker/email-worker.ts --continuous",
    "migrate:sqlite-to-postgres": "node --import tsx scripts/migrate-sqlite-to-postgres.ts",
    "test": "node --import tsx --test server/**/*.test.ts",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "nuxt": "3.21.10",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/pg": "^8.20.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.9"
  },
  "optionalDependencies": {
    "@oxc-minify/binding-linux-x64-gnu": "0.141.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.140.0",
    "@oxc-transform/binding-linux-x64-gnu": "0.141.0",
    "@rolldown/binding-linux-x64-gnu": "1.2.1",
    "@rollup/rollup-linux-x64-gnu": "4.62.3",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
